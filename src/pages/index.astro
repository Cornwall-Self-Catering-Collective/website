---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const homepage = await getEntry("homepage", "index");

if (!homepage) {
  throw new Error("Missing homepage content entry at src/content/homepage/index.md");
}

const { data } = homepage;
const title = data.pageTitle;
const description = data.seoDescription;
---

<BaseLayout {title} {description}>
  <section
    class="relative isolate flex min-h-[420px] items-end overflow-hidden bg-[#287d89]"
    aria-labelledby="hero-heading"
  >
    <img
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      src="/assets/images/cornwall-coast-hero.png"
      alt="The Cornish coast at sunrise"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/65 via-black/10 to-transparent"></div>
    <div class="mx-auto w-full max-w-[1200px] px-6 pb-12 sm:px-8 sm:pb-16">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-white/90">
        {data.heroEyebrow}
      </p>
      <h1 id="hero-heading" class="max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl">
        {data.heroHeading}
      </h1>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1200px] gap-12 px-6 py-16 sm:px-8 lg:grid-cols-[1fr_420px] lg:items-center lg:py-20">
    <div class="max-w-2xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-csc-pink">
        {data.missionEyebrow}
      </p>
      <h2 class="mb-6 text-3xl font-bold leading-tight">
        {data.missionHeading}
      </h2>
      <p class="mb-5 leading-relaxed">{data.missionParagraphOne}</p>
      <p class="leading-relaxed">{data.missionParagraphTwo}</p>
    </div>

    <a
      class="newsletter-card group block h-[250px] rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csc-pink"
      href="https://confirmsubscription.com/h/y/75C5AEA408B8065D"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Sign up to our newsletter (opens in a new tab)"
    >
      <span class="newsletter-card__inner relative block h-full w-full">
        <span class="newsletter-card__face absolute inset-0 flex flex-col justify-between overflow-hidden bg-csc-pink p-8 text-white shadow-xl">
          <span class="text-sm font-semibold uppercase tracking-[0.16em]">Stay connected</span>
          <span class="text-3xl font-bold leading-tight">Newsletter</span>
          <span class="text-sm">Click to Join!</span>
        </span>
        <span class="newsletter-card__face newsletter-card__back absolute inset-0 flex flex-col justify-between overflow-hidden bg-csc-teal p-8 text-white shadow-xl">
          <img
            class="h-auto w-28 brightness-0 invert"
            src="/assets/images/cornwall-self-catering-collective-logo.png"
            alt=""
          />
          <span class="text-2xl font-bold">Click here to sign up →</span>
        </span>
      </span>
    </a>
  </section>
</BaseLayout>
