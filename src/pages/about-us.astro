---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const about = await getEntry("about", "index");

if (!about) {
  throw new Error("Missing about page content entry at src/content/about/index.md");
}

const { data } = about;
const title = data.pageTitle;
const description = data.seoDescription;
---

<BaseLayout {title} {description}>
  <section class="bg-csc-peach/20">
    <div class="mx-auto max-w-[1200px] px-6 py-16 sm:px-8 sm:py-20">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.16em] text-csc-pink">{data.heroEyebrow}</p>
      <h1 class="max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">
        {data.heroHeading}
      </h1>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1200px] gap-12 px-6 py-16 sm:px-8 lg:grid-cols-[1.3fr_0.7fr] lg:py-20">
    <div class="space-y-6 text-[1.05rem] leading-relaxed">
      <p>{data.introParagraphOne}</p>
      <p>{data.introParagraphTwo}</p>
    </div>
    <aside class="border-l-4 border-csc-cyan bg-[#f4fbfb] p-8">
      <h2 class="mb-4 text-2xl font-bold">{data.standForHeading}</h2>
      <ul class="space-y-3 leading-relaxed">
        {
          data.standForItems.map((item) => (
            <li>{item}</li>
          ))
        }
      </ul>
    </aside>
  </section>
</BaseLayout>
